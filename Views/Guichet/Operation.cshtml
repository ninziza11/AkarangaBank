@using AkarangaBank.Web.ViewModels
@model OperationGuichetViewModel

@{
    ViewData["Title"] = "Opération de Caisse";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white">
                <h4 class="mb-0"><i class="bi bi-cash-coin"></i> Guichet - Dépôt & Retrait d'espèces</h4>
            </div>
            <div class="card-body">
                <form asp-action="Operation" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Type d'opération (Boutons radio stylisés) -->
                    <div class="mb-3 text-center">
                        <label class="form-label d-block font-weight-bold">Nature du mouvement</label>
                        <div class="btn-group w-100" role="group">
                            <input type="radio" class="btn-check" asp-for="TypeOperation" value="Depot" id="radioDepot" checked>
                            <label class="btn btn-outline-success" for="radioDepot"><i class="bi bi-box-arrow-in-down"></i> Verser (Dépôt)</label>

                            <input type="radio" class="btn-check" asp-for="TypeOperation" value="Retrait" id="radioRetrait">
                            <label class="btn btn-outline-danger" for="radioRetrait"><i class="bi bi-box-arrow-up"></i> Retirer (Retrait)</label>
                        </div>
                    </div>

                    <!-- Numéro de compte -->
                    <div class="mb-3">
                        <label asp-for="NumeroCompte" class="form-label font-weight-bold">Numéro de compte</label>
                        <input asp-for="NumeroCompte" class="form-control font-monospace fw-bold" placeholder="Ex: BJM-0001-0001" />
                        <span asp-validation-for="NumeroCompte" class="text-danger"></span>
                    </div>

                    <!-- Montant -->
                    <div class="mb-3">
                        <label asp-for="Montant" class="form-label font-weight-bold">Montant en numéraire</label>
                        <div class="input-group">
                            <input asp-for="Montant" type="number" class="form-control text-end fw-bold" placeholder="0" />
                            <span class="input-group-text">BIF</span>
                        </div>
                        <span asp-validation-for="Montant" class="text-danger"></span>
                    </div>

                    <!-- Nom de la personne physique -->
                    <div class="mb-3">
                        <label asp-for="NomDonneur" class="form-label font-weight-bold">Identité du déposant / tireur</label>
                        <input asp-for="NomDonneur" class="form-control" placeholder="Nom et Prénom de la personne devant vous" />
                        <span asp-validation-for="NomDonneur" class="text-danger"></span>
                    </div>

                    <!-- Remarque -->
                    <div class="mb-3">
                        <label asp-for="Remarque" class="form-label font-weight-bold">Motif du versement ou du retrait</label>
                        <input asp-for="Remarque" class="form-control" placeholder="Ex: Alimentation de compte, Retrait chèque N°..." />
                        <span asp-validation-for="Remarque" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="Comptes" asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Valider l'opération de caisse</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
