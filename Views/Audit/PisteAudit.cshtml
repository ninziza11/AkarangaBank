@using AkarangaBank.Web.ViewModels
@model AuditIndexViewModel

@{
    ViewData["Title"] = "Piste d'Audit Réglementaire";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2><i class="bi bi-shield-shaded text-dark"></i> Piste d'Audit & Journal d'Activité</h2>
            <p class="text-muted mb-0">Rapport de traçabilité immuable conforme aux directives de sécurité LAB/CFT de la BRB.</p>
        </div>
    </div>

    <!-- Barre de Recherche et de Filtrage Analytique -->
    <div class="card bg-light mb-4 shadow-sm">
        <div class="card-body">
            <form asp-action="PisteAudit" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Recherche par Opérateur / Acteur</label>
                    <input type="text" name="rechercheUtilisateur" value="@Model.RechercheUtilisateur" class="form-control form-control-sm" placeholder="Ex: admin, guichetier..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold">Filtrer par module cible</label>
                    <select name="filtreTable" class="form-select form-select-sm">
                        <option value="">-- Tous les modules --</option>
                        <option value="Clients">Dossiers Clients / KYC</option>
                        <option value="Comptes">Comptes Bancaires</option>
                        <option value="Virements">Flux de Virements</option>
                        <option value="Utilisateurs">Habilitations & Rôles</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-dark btn-sm w-100"><i class="bi bi-search"></i> Analyser les logs</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tableau de Traçabilité -->
    <div class="card shadow-sm mb-5">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0"><i class="bi bi-list-columns"></i> Événements de sécurité horodatés</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle small">
                    <thead class="table-light text-uppercase font-weight-bold">
                        <tr>
                            <th>Horodatage (UTC)</th>
                            <th>Opérateur</th>
                            <th>Action Sécurité</th>
                            <th>Module</th>
                            <th>Réf. ID</th>
                            <th>Adresse IP / Terminal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Logs != null && Model.Logs.Any())
                        {
                            foreach (var log in Model.Logs)
                            {
                                <tr>
                                    <td class="font-monospace text-muted">@log.DateEvenement.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td class="fw-bold text-primary">@log.Utilisateur</td>
                                    <td>
                                        <span class="badge bg-outline-dark border text-dark font-monospace">@log.Action</span>
                                    </td>
                                    <td><span class="badge bg-light text-dark">@log.TableConcernee</span></td>
                                    <td class="font-monospace fw-bold">@(log.EnregistrementId ?? "-")</td>
                                    <td class="font-monospace small">
                                        <span class="d-block"><i class="bi bi-laptop me-1"></i> @log.AdresseIP</span>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-journal-x fs-3 d-block mb-2"></i> Aucun log d'activité enregistré pour ces critères.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
