@model IEnumerable<AkarangaBank.Web.Models.Carte>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestion des Cartes Monétiques";
}

<div class="container-fluid" role="region" aria-labelledby="cards-title">
    <!-- 🏢 BANDEAU HARMONISÉ -->
    <div class="card card-custom p-4 mb-4 border-start border-primary border-5 bg-white shadow-sm">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h1 id="cards-title" class="h3 fw-bold text-dark mb-1">
                    <i class="bi bi-credit-card text-primary me-2"></i> Sécurité des Cartes Bancaires
                </h1>
                <p class="text-muted small mb-0">Registre de blocage, déclaration de perte et gestion des statuts Visa et MasterCard d'agence.</p>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success small mb-3"><i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]</div>
    }

    <!-- 📊 LISTE DES CARTES -->
    <div class="card card-custom p-0 border-0 bg-white overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 small">
                <thead class="table-dark">
                    <tr>
                        <th>ID Système</th>
                        <th>Numéro Masqué</th>
                        <th>Réseau</th>
                        <th>Expiration</th>
                        <th>Statut</th>
                        <th class="text-end">Actions Guichet</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-monospace fw-bold">#CRT-@item.Id.ToString("D4")</td>
                            <td class="font-monospace fw-bold text-dark">@item.NumeroCarte</td>
                            <td>
                                <span class="badge bg-outline-dark border border-dark text-dark fw-bold text-uppercase">@item.TypeCarte</span>
                            </td>
                            <td class="font-monospace">@item.DateExpiration.ToString("MM/yyyy")</td>
                            <td>
                                @if (item.Statut == "Active") { <span class="badge bg-success">Active</span> }
                                else { <span class="badge bg-danger text-uppercase fw-bold">@item.Statut</span> }
                            </td>
                            <td class="text-end">
                                @if (item.Statut == "Active")
                                {
                                    <form asp-action="Bloquer" asp-route-id="@item.Id" method="post" class="m-0 d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-xs btn-danger py-0 px-2 fw-bold" style="font-size:0.75rem;">
                                            <i class="bi bi-slash-circle me-1"></i> Mettre en Opposition
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
