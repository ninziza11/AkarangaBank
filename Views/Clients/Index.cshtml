@using AkarangaBank.Web.ViewModels
@model ClientListViewModel

@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-people"></i> Liste des Clients</h1>
    <div class="gap-2 d-flex">
        <!-- EXERCICE 4 : BOUTON EXTRACTION CSV EXCEL -->
        <a asp-action="ExporterCSV" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet-fill"></i> Exporter en CSV
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus-fill"></i> Nouveau Client
        </a>
    </div>
</div>

<table class="table">
    <thead>
        <tr>
            <th>Numéro</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Téléphone</th>
            <th>Email</th>
            <th>Statut</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Clients != null && Model.Clients.Any())
        {
            @foreach (var client in Model.Clients)
            {
                <tr>
                    <td>@client.NumeroClient</td>
                    <td>@client.Nom</td>
                    <td>@client.Prenom</td>
                    <td>@client.Telephone</td>
                    <td>@client.Email</td>
                    <td>@client.Statut</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-primary btn-sm">Détails</a>
                        <a asp-action="Edit" asp-route-id="@client.Id" class="btn btn-warning btn-sm">Modifier</a>
                        <a asp-action="Delete" asp-route-id="@client.Id" class="btn btn-danger btn-sm">Supprimer</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center text-muted">Aucun client trouvé.</td>
            </tr>
        }
    </tbody>
</table>
