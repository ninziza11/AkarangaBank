@using AkarangaBank.Web.ViewModels
@model ClientCreateViewModel

@{
    ViewData["Title"] = "Nouveau client";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="bi bi-person-plus-fill"></i> Créer un Nouveau Client</h2>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <!-- Numéro Client -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NumeroClient" class="form-label font-weight-bold">Numéro de Client</label>
                        <input asp-for="NumeroClient" class="form-control" placeholder="Ex: CLI-2026-001" />
                        <span asp-validation-for="NumeroClient" class="text-danger"></span>
                    </div>

                    <!-- Numéro CNI -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="NumeroCNI" class="form-label font-weight-bold">Numéro CNI</label>
                        <input asp-for="NumeroCNI" class="form-control" placeholder="Numéro de carte d'identité" />
                        <span asp-validation-for="NumeroCNI" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Nom -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nom" class="form-label font-weight-bold">Nom</label>
                        <input asp-for="Nom" class="form-control" placeholder="Nom de famille" />
                        <span asp-validation-for="Nom" class="text-danger"></span>
                    </div>

                    <!-- Prénom -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Prenom" class="form-label font-weight-bold">Prénom</label>
                        <input asp-for="Prenom" class="form-control" placeholder="Prénom" />
                        <span asp-validation-for="Prenom" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Date de Naissance -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="DateNaissance" class="form-label font-weight-bold">Date de Naissance</label>
                        <input asp-for="DateNaissance" type="date" class="form-control" />
                        <span asp-validation-for="DateNaissance" class="text-danger"></span>
                    </div>

                    <!-- Téléphone -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Telephone" class="form-label font-weight-bold">Téléphone</label>
                        <input asp-for="Telephone" class="form-control" placeholder="Numéro de téléphone" />
                        <span asp-validation-for="Telephone" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label font-weight-bold">Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="exemple@domaine.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Adresse -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="Adresse" class="form-label font-weight-bold">Adresse</label>
                        <input asp-for="Adresse" class="form-control" placeholder="Adresse de résidence" />
                        <span asp-validation-for="Adresse" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <!-- Liste déroulante des Agences -->
                    <div class="col-md-12 mb-4">
                        <label asp-for="AgenceId" class="form-label font-weight-bold">Agence</label>
                        <select asp-for="AgenceId" class="form-select" asp-items="Model.AgencesDisponibles">
                            <option value="">-- Sélectionner une agence --</option>
                        </select>
                        <span asp-validation-for="AgenceId" class="text-danger"></span>
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle-fill"></i> Créer le client
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Retour à la liste
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
