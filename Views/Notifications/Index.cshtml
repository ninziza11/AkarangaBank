@model System.Collections.Generic.List<AkarangaBank.Web.Models.AlerteAML>

@{
    ViewData["Title"] = "Notifications";

    var erreurChargement =
        ViewData["ErreurChargement"] as string;

    var nombreAlertes = Model.Count;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-1">Notifications</h1>

            <p class="text-muted mb-0">
                Alertes AML enregistrées dans la base de données.
            </p>
        </div>

        <a href="@Url.Action("Index", "Notifications")"
           class="btn btn-outline-primary">
            Actualiser
        </a>
    </div>

    @if (TempData["Success"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    @if (TempData["Error"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(erreurChargement))
    {
        <div class="alert alert-danger" role="alert">
            @erreurChargement
        </div>

        <p class="text-muted">
            Le chargement a échoué. Il est donc impossible de confirmer
            la présence ou l’absence d’une alerte Structuring.
        </p>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Liste des notifications</span>

                <span class="badge bg-secondary">
                    @nombreAlertes alerte(s)
                </span>
            </div>

            <div class="card-body">

                @if (nombreAlertes == 0)
                {
                    <div class="alert alert-info mb-0" role="status">
                        Aucune alerte AML n’a été retournée par la base.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Type d’alerte</th>
                                    <th scope="col">Niveau</th>
                                    <th scope="col">Description</th>
                                    <th scope="col">Statut</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var alerte in Model)
                                {
                                    var estStructuring =
                                        alerte.TypeAlerte?.IndexOf(
                                            "Structuring",
                                            System.StringComparison.OrdinalIgnoreCase
                                        ) >= 0;

                                    <tr class="@(estStructuring ? "table-warning" : "")">
                                        <td>@alerte.Id</td>

                                        <td>
                                            @alerte.TypeAlerte

                                            @if (estStructuring)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">
                                                    Structuring
                                                </span>
                                            }
                                        </td>

                                        <td>@alerte.Niveau</td>

                                        <td style="white-space: pre-wrap;">@alerte.Description</td>

                                        <td>@alerte.Statut</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="text-muted small mb-0">
                        Les alertes dont le type contient « Structuring »
                        sont surlignées. Cet affichage ne crée aucune alerte.
                    </p>
                }

            </div>
        </div>
    }

</div>