@model IEnumerable<AkarangaBank.Web.Models.AlerteAML>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Vigilance LAB/CFT";
}

<div class="container-fluid" role="region" aria-labelledby="aml-title">
    <!-- 🏢 BANDEAU HARMONISÉ AZUR ROYAL -->
    <div class="card card-custom p-4 mb-4 border-start border-danger border-5 bg-white shadow-sm">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h1 id="aml-title" class="h3 fw-bold text-dark mb-1">
                    <i class="bi bi-shield-exclamation text-danger me-2"></i> Vigilance LAB/CFT & Alertes AML
                </h1>
                <p class="text-muted small mb-0">Registre de surveillance réglementaire conforme aux directives anti-blanchiment de la BRB.</p>
            </div>
            <span class="badge bg-danger px-3 py-2 fw-bold text-uppercase">Seuil : >= 5 000 000 BIF</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success small mb-3"><i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]</div>
    }

    <!-- 📊 REGISTRE DES ALERTES -->
    <div class="card card-custom p-0 border-0 bg-white overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 small">
                <thead class="table-dark">
                    <tr>
                        <th>ID Jeton</th>
                        <th>Type d'Alerte</th>
                        <th>Niveau</th>
                        <th>Description de l'incident</th>
                        <th>Statut</th>
                        <th class="text-end">Actions de Contrôle</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-monospace fw-bold">#AML-@item.Id.ToString("D4")</td>
                            <td class="fw-bold text-dark">@item.TypeAlerte</td>
                            <td>
                                <span class="badge bg-danger text-uppercase fw-bold">@item.Niveau</span>
                            </td>
                            <td class="text-muted text-wrap" style="max-width: 400px;">@item.Description</td>
                            <td>
                                @if (item.Statut == "Ouverte") { <span class="badge bg-warning text-dark">Dossier Ouvert</span> }
                                else { <span class="badge bg-success">@item.Statut</span> }
                            </td>
                            <td class="text-end">
                                @if (item.Statut == "Ouverte" && User.IsInRole("auditeur"))
                                {
                                    <div class="d-flex justify-content-end gap-1">
                                        <form asp-action="TraiterAlerte" asp-route-id="@item.Id" asp-route-nouveauStatut="Traitee" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-xs btn-success py-0 px-2 fw-bold" style="font-size:0.75rem;">Investiguer</button>
                                        </form>
                                        <form asp-action="TraiterAlerte" asp-route-id="@item.Id" asp-route-nouveauStatut="Classee" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-xs btn-outline-secondary py-0 px-2 fw-bold" style="font-size:0.75rem;">Classer</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
