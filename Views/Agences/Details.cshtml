@using AkarangaBank.Web.ViewModels
@model AgenceDetailsViewModel

@{
    ViewData["Title"] = "Détails de l'Agence";
}

<div class="container mt-4">
    @if (Model?.Agence != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h2 class="mb-0"><i class="bi bi-building"></i> Détails de l'Agence : @Model.Agence.Nom</h2>
                <span class="badge bg-info fs-6">Code : @Model.Agence.Code</span>
            </div>
            <div class="card-body">
                <div class="row bg-light p-3 rounded mb-4">
                    <div class="col-sm-3 font-weight-bold">Nom de l'agence :</div>
                    <div class="col-sm-9">@Model.Agence.Nom</div>

                    <div class="col-sm-3 font-weight-bold mt-2">Code Unique :</div>
                    <div class="col-sm-9 mt-2">@Model.Agence.Code</div>

                    <div class="col-sm-3 font-weight-bold mt-2">Ville :</div>
                    <div class="col-sm-9 mt-2">@Model.Agence.Ville</div>

                    <div class="col-sm-3 font-weight-bold mt-2">Type d'agence :</div>
                    <div class="col-sm-9 mt-2">
                        @if (Model.Agence.EstSiege)
                        {
                            <span class="badge bg-danger"><i class="bi bi-star-fill"></i> Siège Social</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Succursale</span>
                        }
                    </div>
                </div>

                <!-- Boutons de navigation -->
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Agence.Id" class="btn btn-warning">
                        <i class="bi bi-pencil-square"></i> Modifier l'agence
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Retour aux agences
                    </a>
                </div>
            </div>
        </div>

        <!-- Section des Statistiques -->
        <div class="row">
            <div class="col-md-4 mb-3">
                <div class="card border-primary h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title text-primary"><i class="bi bi-people-fill fs-3"></i></h5>
                        <h6 class="card-subtitle mb-2 text-muted">Nombre de Clients</h6>
                        <p class="card-text display-6 font-weight-bold">@Model.NombreClients</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card border-success h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title text-success"><i class="bi bi-credit-card-2-front-fill fs-3"></i></h5>
                        <h6 class="card-subtitle mb-2 text-muted">Nombre de Comptes</h6>
                        <p class="card-text display-6 font-weight-bold">@Model.NombreComptes</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-3">
                <div class="card border-info h-100 shadow-sm">
                    <div class="card-body text-center">
                        <h5 class="card-title text-info"><i class="bi bi-shield-lock-fill fs-3"></i></h5>
                        <h6 class="card-subtitle mb-2 text-muted">Nombre d'Utilisateurs</h6>
                        <p class="card-text display-6 font-weight-bold">@Model.NombreUtilisateurs</p>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger text-center">
            <h4><i class="bi bi-exclamation-triangle-fill"></i> Erreur</h4>
            <p>Impossible de charger les données de cette agence.</p>
            <a asp-action="Index" class="btn btn-outline-danger mt-2">Retour à la liste</a>
        </div>
    }
</div>
