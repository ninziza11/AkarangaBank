@model AkarangaBank.Web.Models.Client

@{
    ViewData["Title"] = "Détails du client";
}

<h1>Détails du client</h1>

<dl class="row">
    <dt class="col-sm-3">Numéro client</dt>
    <dd class="col-sm-9">@Model.NumeroClient</dd>

    <dt class="col-sm-3">Nom</dt>
    <dd class="col-sm-9">@Model.Nom</dd>

    <dt class="col-sm-3">Prénom</dt>
    <dd class="col-sm-9">@Model.Prenom</dd>

    <dt class="col-sm-3">Téléphone</dt>
    <dd class="col-sm-9">@Model.Telephone</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Adresse</dt>
    <dd class="col-sm-9">@Model.Adresse</dd>

    <dt class="col-sm-3">Statut</dt>
    <dd class="col-sm-9">@Model.Statut</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">
    Retour
</a>