@model AkarangaBank.Web.ViewModels.JournalViewModel
@{ ViewData["Title"] = "Journal des opérations"; }
<h1>Journal des opérations</h1>
@if (TempData["Success"] is string msg)
{
 <div class="alert alert-success">@msg</div>
}
<form method="get" class="row g-2 mb-3">
 <div class="col-md-2">
 <input type="date" name="du" value="@Model.Du?.ToString("yyyy-MM-dd")" cla
ss="form-control" />
 </div>
 <div class="col-md-2">
 <input type="date" name="au" value="@Model.Au?.ToString("yyyy-MM-dd")" cla
ss="form-control" />
 </div>
 <div class="col-md-2">
 <select name="typeOperation" class="form-select">
 <option value="">Tous les types</option>
 <option value="Depot" selected="@(Model.TypeOperation == "Depot")">Dép
ôt</option>
 <option value="Retrait" selected="@(Model.TypeOperation == "Retrait")"
>Retrait</option>
 <option value="Virement" selected="@(Model.TypeOperation == "Virement"
)">Virement</option>
 </select>
 </div>
 <div class="col-md-2">
 <button type="submit" class="btn btn-primary">Filtrer</button>
 </div>
</form>
<table class="table table-striped table-sm">
 <thead>
 <tr>
 <th>Date</th>
 <th>Référence</th>
 <th>Type</th>
 <th>Compte</th>
 <th class="text-end">Montant</th>
 <th>Statut</th>
 <th></th>
 </tr>
 </thead>
 <tbody>
 @foreach (var op in Model.Operations)
 {
 <tr>
 <td>@op.DateOperation.ToString("dd/MM/yyyy HH:mm")</td>
 <td>@op.Reference</td>
 <td>@op.TypeOperation</td>
 <td>@op.Compte.NumeroCompte</td>
 <td class="text-end">@op.Montant.ToString("N2") @op.Devise</td>
 <td>
 <span class="badge @(op.Statut == "Valide" ? "bg-success" :
 op.Statut == "EnAttente" ? "bg-warning text-dark" : "bg-secondary")">
 </span>
 </td>
 <td>
    <a asp-action="Releve" asp-route-id="@op.CompteId" class="btn btnsm btn-outline-primary">Relevé</a>
 </td>
 </tr>
 }
 </tbody>
</table>
@if (Model.TotalPages > 1)
{
 <nav>
 <ul class="pagination">
 @for (int i = 1; i <= Model.TotalPages; i++)
 {
 <li class="page-item @(i == Model.Page ? "active" : "")">
 <a class="page-link" asp-action="Journal" asp-route-page="@i"
 asp-route-du="@Model.Du?.ToString("yyyy-MM-dd")"
 asp-route-au="@Model.Au?.ToString("yyyy-MM-dd")"
 asp-route-typeOperation="@Model.TypeOperation">@i</a>
 </li>
 }
 </ul>
 </nav>
}