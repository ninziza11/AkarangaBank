@model AkarangaBank.Web.ViewModels.VirementViewModel
@{
    ViewData["Title"] = "Virement";
}

<h1>Virement</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Virement" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="CompteSourceId" class="form-label"></label>
                <select asp-for="CompteSourceId"
                        asp-items="ViewBag.Comptes"
                        class="form-select">
                    <option value="">-- Sélectionner le compte source --</option>
                </select>
                <span asp-validation-for="CompteSourceId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CompteDestinationId" class="form-label"></label>
                <select asp-for="CompteDestinationId"
                        asp-items="ViewBag.ComptesDestination"
                        class="form-select">
                    <option value="">-- Sélectionner le compte destination --</option>
                </select>
                <span asp-validation-for="CompteDestinationId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Montant" class="form-label"></label>
                <input asp-for="Montant" class="form-control" />
                <span asp-validation-for="Montant" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Motif" class="form-label"></label>
                <textarea asp-for="Motif" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Motif" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Effectuer le virement
            </button>
        </form>
    </div>
</div>