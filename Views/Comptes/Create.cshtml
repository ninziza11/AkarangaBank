@model AkarangaBank.Web.ViewModels.CompteCreateViewModel

@{
    ViewData["Title"] = "Ouverture de Compte";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-wallet2"></i> Ouvrir un Compte Bancaire</h4>
            </div>
            <div class="card-body">
                <p>Client bénéficiaire : <strong>@Model.ClientNomComplet</strong></p>
                <hr />

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ClientId" />
                    <input type="hidden" asp-for="ClientNomComplet" />

                    <div class="mb-3">
                        <label asp-for="TypeCompteId" class="form-label">Type de produit bancaire</label>
                        <select asp-for="TypeCompteId" asp-items="Model.TypesCompteDisponibles" class="form-select">
                            <option value="">-- Sélectionnez le produit --</option>
                        </select>
                        <span asp-validation-for="TypeCompteId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AgenceId" class="form-label">Agence de gestion comptable</label>
                        <select asp-for="AgenceId" asp-items="Model.AgencesDisponibles" class="form-select"></select>
                        <span asp-validation-for="AgenceId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Devise" class="form-label">Devise du compte</label>
                        <input asp-for="Devise" class="form-control" readonly />
                        <span asp-validation-for="Devise" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Valider l'ouverture</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
