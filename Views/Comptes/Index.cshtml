@model IEnumerable<AkarangaBank.Web.Models.Compte>
@{
    ViewData["Title"] = "Grand Livre des Comptes";
}

<div class="container-fluid p-0" role="region" aria-labelledby="page-title">
    
    <!-- 🏢 BANDEAU DE SYNTHÈSE ADOUCI -->
    <div class="card card-custom p-4 mb-4 border-start border-warning border-5 shadow-sm" style="background-color: #1e293b; border-color: #334155;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 id="page-title" class="h4 fw-bold text-white mb-1">
                    <i class="bi bi-journal-bookmark-fill text-warning me-2"></i> Grand Livre des Comptes
                </h1>
                <p class="text-muted small mb-0">Registre de surveillance des positions d'agence, des soldes de départ et de la conformité réglementaire.</p>
            </div>
            @if (User.IsInRole("admin") || User.IsInRole("gestionnaire"))
            {
                <a asp-action="Index" asp-controller="Clients" class="btn btn-sm btn-warning fw-bold px-3 py-2 rounded-3 shadow">
                    <i class="bi bi-person-plus-fill me-1"></i> Ouvrir un Compte
                </a>
            }
        </div>
    </div>

    <!-- 📊 REGISTRE DES COMPTES (AFFICHÉ À DROITE DU MENU) -->
    <div class="card card-custom p-0 border-0 overflow-hidden shadow-sm" style="background-color: #1e293b;">
        <div class="table-responsive">
            <table class="table align-middle mb-0 small table-dark table-striped">
                <thead style="background-color: #0f172a; border-bottom: 2px solid #f59e0b;">
                    <tr>
                        <th class="p-3 text-warning">N° Compte d'Agence</th>
                        <th class="text-warning">Client / Titulaire</th>
                        <th class="text-warning">Type de Compte</th>
                        <th class="text-end text-warning">Solde Disponible</th>
                        <th class="text-center text-warning">Statut</th>
                        <th class="text-end p-3 text-warning">Actions de Caisse</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-exclamation-circle fs-4 text-warning d-block mb-2"></i>
                                Aucun compte actif enregistré dans le grand livre d'agence.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr style="border-bottom: 1px solid #334155;">
                                <td class="p-3 font-money" style="color: #38bdf8;">@item.NumeroCompte</td>
                                <td class="fw-bold text-white text-uppercase">@item.Client?.Nom @item.Client?.Prenom</td>
                                <td>
                                    <span class="badge bg-secondary bg-opacity-30 text-white-50 border border-secondary">
                                        @item.TypeCompte?.Libelle
                                    </span>
                                </td>
                                <!-- Couleur Azur clair pour un contraste optimal sans fatigue oculaire -->
                                <td class="text-end font-money fw-bold" style="color: #38bdf8; font-size: 1.05rem;">
                                    @string.Format("{0:N2}", item.Solde) BIF
                                </td>
                                <td class="text-center">
                                    @if (item.Statut == "Actif") 
                                    { 
                                        <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30">Actif</span> 
                                    }
                                    else 
                                    { 
                                        <span class="badge bg-danger bg-opacity-20 text-danger border border-danger border-opacity-30">@item.Statut</span> 
                                    }
                                </td>
                                <td class="text-end p-3">
                                    <div class="d-flex justify-content-end gap-2">
                                        @if (User.IsInRole("guichetier") || User.IsInRole("admin"))
                                        {
                                            <a asp-controller="Transactions" asp-action="Guichet" asp-route-numeroCompte="@item.NumeroCompte" class="btn btn-xs btn-success py-1 px-2 fw-bold text-dark" style="font-size:0.8rem; background-color: #10b981; border: none;">
                                                <i class="bi bi-cash"></i> Guichet
                                            </a>
                                        }
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning fw-bold py-1 px-2" style="font-size:0.8rem;">
                                            <i class="bi bi-eye-fill"></i> Inspecter
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
