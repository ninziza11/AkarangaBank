@model AkarangaBank.Web.Models.Compte

@{
    ViewData["Title"] = "Détails du compte";
}

<div class="container mt-4">
    <h1><i class="bi bi-wallet2"></i> Détails du compte</h1>
    <hr />

    <dl class="row bg-light p-3 rounded shadow-sm">
        <dt class="col-sm-3 font-weight-bold">Numéro de compte</dt>
        <dd class="col-sm-9"><span class="badge bg-secondary fs-6">@Model.NumeroCompte</span></dd>

        <dt class="col-sm-3 font-weight-bold mt-2">Solde</dt>
        <dd class="col-sm-9 mt-2 font-weight-bold text-primary">@Model.Solde.ToString("N2")</dd>

        <dt class="col-sm-3 font-weight-bold mt-2">Devise</dt>
        <dd class="col-sm-9 mt-2 fw-bold">@Model.Devise</dd>

        <dt class="col-sm-3 font-weight-bold mt-2">Statut</dt>
        <dd class="col-sm-9 mt-2">
            @if (Model.Statut == "Actif")
            {
                <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Actif</span>
            }
            else
            {
                <span class="badge bg-danger"><i class="bi bi-dash-circle-fill"></i> @Model.Statut</span>
            }
        </dd>
    </dl>

    <div class="mt-4 d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil-square"></i> Modifier
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Retour
        </a>
    </div>
</div>
