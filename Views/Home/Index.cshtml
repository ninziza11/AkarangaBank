
@{
    ViewData["Title"] = "Tableau de Bord Core Banking";
}

<div class="container-fluid" role="region" aria-labelledby="dashboard-heading">
    <!-- 🏢 BANDEAU D'ACCUEIL BANCAIRE MUNICIPALE -->
    <div class="card card-custom p-4 mb-4 border-start border-info border-5 bg-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 id="dashboard-heading" class="h3 fw-bold text-dark mb-1">Portail Core Banking — AkarangaBank</h1>
                <p class="text-muted small mb-0">
                    Acteur connecté : <span class="badge bg-dark text-uppercase font-monospace">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                </p>
            </div>
            <div class="text-end small font-monospace text-secondary">
                <i class="bi bi-clock-history"></i> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- 📊 INDICATEURS FINANCIERS DE SUPERVISION (RÉSERVÉ ADMIN) -->
    <!-- ========================================================================= -->
    @if (User.IsInRole("admin"))
    {
        <h5 class="mb-3 fw-bold text-secondary text-uppercase tracking-wider small"><i class="bi bi-grid-1x2-fill me-1"></i> Indicateurs de Supervision</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card card-custom p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted small text-uppercase mb-1">Portefeuille Clients</h6>
                            <h3 class="fw-bold mb-0 text-dark font-monospace">@ViewBag.TotalClients</h3>
                        </div>
                        <div class="fs-1 text-primary opacity-75"><i class="bi bi-people-fill"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-custom p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-muted small text-uppercase mb-1">Comptes Ouverts</h6>
                            <h3 class="fw-bold mb-0 text-dark font-monospace">@ViewBag.TotalComptes</h3>
                        </div>
                        <div class="fs-1 text-success opacity-75"><i class="bi bi-wallet2"></i></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-custom p-3 h-100 border-start border-danger border-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="text-danger small text-uppercase mb-1 fw-bold">Alertes LAB/CFT</h6>
                            <h3 class="fw-bold mb-0 text-danger font-monospace">@ViewBag.AlertesAmlEnAttente</h3>
                        </div>
                        <div class="fs-1 text-danger"><i class="bi bi-shield-fill-exclamation"></i></div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========================================================================= -->
    <!-- ⚡ RACCOURCIS MÉTIERS ET RECOMMANDATIONS DE CONFORMITÉ -->
    <!-- ========================================================================= -->
    <div class="row g-4">
        <!-- Colonne Gauche : Actions Rapides -->
        <div class="col-lg-8">
            <div class="card card-custom p-4 h-100">
                <h5 class="fw-bold text-dark mb-4"><i class="bi bi-lightning-charge-fill text-warning"></i> Actions rapides disponibles</h5>
                <div class="row g-3">
                    @if (User.IsInRole("guichetier") || User.IsInRole("admin") || User.IsInRole("gestionnaire"))
                    {
                        <div class="col-md-6">
                            <a asp-controller="Clients" asp-action="Create" class="btn btn-outline-dark card-custom text-start p-3 w-100 h-100 d-flex align-items-center gap-3 bg-white text-decoration-none">
                                <span class="fs-3 text-primary"><i class="bi bi-person-plus-fill"></i></span>
                                <div>
                                    <strong class="d-block text-dark small fw-bold">Entrée en Relation (KYC)</strong>
                                    <span class="text-muted xsmall d-block mt-1">Numériser les pièces et valider un nouveau client.</span>
                                </div>
                            </a>
                        </div>
                    }
                    @if (User.IsInRole("gestionnaire") || User.IsInRole("admin"))
                    {
                        <div class="col-md-6">
                            <a asp-controller="Chequiers" asp-action="Index" class="btn btn-outline-dark card-custom text-start p-3 w-100 h-100 d-flex align-items-center gap-3 bg-white text-decoration-none">
                                <span class="fs-3 text-info"><i class="bi bi-journal-bookmark-fill"></i></span>
                                <div>
                                    <strong class="d-block text-dark small fw-bold">Gestion des Chéquiers</strong>
                                    <span class="text-muted xsmall d-block mt-1">Commander, fabriquer ou mettre en opposition.</span>
                                </div>
                            </a>
                        </div>
                    }
                    @if (User.IsInRole("auditeur") || User.IsInRole("admin"))
                    {
                        <div class="col-md-6">
                            <a asp-controller="Audit" asp-action="PisteAudit" class="btn btn-outline-dark card-custom text-start p-3 w-100 h-100 d-flex align-items-center gap-3 bg-white text-decoration-none">
                                <span class="fs-3 text-warning"><i class="bi bi-shield-shaded"></i></span>
                                <div>
                                    <strong class="d-block text-dark small fw-bold">Journal d'Audit</strong>
                                    <span class="text-muted xsmall d-block mt-1">Consulter la traçabilité des actions des agents.</span>
                                </div>
                            </a>
                        </div>
                    }
                    <div class="col-md-6">
                        <a asp-controller="Comptes" asp-action="Index" class="btn btn-outline-dark card-custom text-start p-3 w-100 h-100 d-flex align-items-center gap-3 bg-white text-decoration-none">
                            <span class="fs-3 text-success"><i class="bi bi-wallet2"></i></span>
                            <div>
                                <strong class="d-block text-dark small fw-bold">Consultation Générale</strong>
                                <span class="text-muted xsmall d-block mt-1">Consulter la liste complète des comptes ouverts.</span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Colonne Droite : Rappels BRB -->
        <div class="col-lg-4">
            <div class="card card-custom p-4 h-100 bg-white">
                <h5 class="fw-bold text-dark mb-3"><i class="bi bi-info-square-fill text-info"></i> Directives BRB</h5>
                <div class="d-flex flex-column gap-3 small">
                    <div class="p-2 border-bottom border-light">
                        <i class="bi bi-shield-fill-check text-success me-1"></i> <strong>Seuil National LAB :</strong> 
                        Tout mouvement &ge; <strong>15 000 000 BIF</strong> requiert la saisie immédiate du document de provenance.
                    </div>
                    <div class="p-2 border-bottom border-light">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i> <strong>Mise à jour KYC :</strong> 
                        Les pièces d'identité expirées bloquent l'initiation de tout virement sortant.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .xsmall { font-size: 0.78rem; line-height: 1.2; }
</style>
