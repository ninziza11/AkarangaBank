@model IEnumerable<AkarangaBank.Web.Models.ApplicationUser>
@{
    ViewData["Title"] = "Administration des Acteurs d'Agence";
}

<div class="container-fluid p-0" role="region" aria-labelledby="page-title">
    
    <!-- 🏢 BANDEAU DE SYNTHÈSE DES HABILITATIONS SÉCURISÉES -->
    <div class="card card-custom p-4 mb-4 border-start border-warning border-5 shadow-sm" style="background-color: #1e293b; border-color: #334155;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 id="page-title" class="h4 fw-bold text-white mb-1">
                    <i class="bi bi-people-fill text-warning me-2"></i> Administration des Utilisateurs
                </h1>
                <p class="text-muted small mb-0">Gestion réglementaire des habilitations d'acteurs, affectations d'agences et statuts de sécurité 2FA.</p>
            </div>
            <div class="text-end">
                <a asp-action="Create" class="btn btn-sm btn-warning fw-bold px-3 py-2 rounded-3 shadow">
                    <i class="bi bi-person-plus-fill me-1"></i> + Nouvel Acteur
                </a>
            </div>
        </div>
    </div>

    @if (TempData["Success"] is string msg)
    {
        <div class="alert alert-success bg-success bg-opacity-20 text-success border border-success border-opacity-30 small mb-3">
            <i class="bi bi-check-circle-fill me-2"></i> @msg
        </div>
    }

    <!-- 📊 GRAND TABLEAU DES ACTEURS (AFFICHÉ À DROITE DU MENU) -->
    <div class="card card-custom p-0 border-0 overflow-hidden shadow-sm" style="background-color: #1e293b;">
        <div class="table-responsive">
            <table class="table align-middle mb-0 small table-dark table-striped">
                <thead style="background-color: #0f172a; border-bottom: 2px solid #f59e0b;">
                    <tr>
                        <th class="p-3 text-warning">Nom Complet Agent</th>
                        <th class="text-warning">Adresse E-mail</th>
                        <th class="text-warning">Rôle Profil (RBAC)</th>
                        <th class="text-warning">Agence Affectée</th>
                        <th class="text-center text-warning">Sécurité 2FA</th>
                        <th class="text-center text-warning">Statut Accès</th>
                        <th class="text-end p-3 text-warning">Actions d'Autorité</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr style="border-bottom: 1px solid #334155;">
                            <td class="p-3 fw-bold text-white">@u.NomComplet</td>
                            <td class="font-monospace text-muted">@u.Email</td>
                            <td><span class="badge bg-secondary bg-opacity-40 text-white border border-secondary">@u.Role</span></td>
                            <td class="font-monospace fw-bold text-info">@(u.Agence != null ? u.Agence.Code : "Siège")</td>
                            <td class="text-center">
                                @if (u.DeuxFA_Active) // 🛠️ FIXATION : Propriété alignée sur le dictionnaire
                                {
                                    <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-30">Activée</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-20 text-warning border border-warning border-opacity-30">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @(u.EstActif ? "bg-success bg-opacity-20 text-success border border-success" : "bg-danger bg-opacity-20 text-danger border border-danger") border-opacity-30">
                                    @(u.EstActif ? "Actif" : "Suspendu")
                                </span>
                            </td>
                            <td class="text-end p-3">
                                <form asp-action="ToggleActif" asp-route-id="@u.Id" method="post" class="m-0 d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-xs fw-bold px-3 py-1 rounded @(u.EstActif ? "btn-outline-danger" : "btn-warning text-dark")" style="font-size: 0.8rem;">
                                        <i class="bi @(u.EstActif ? "bi-lock-fill" : "bi-unlock-fill")"></i> @(u.EstActif ? "Suspendre" : "Activer")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
