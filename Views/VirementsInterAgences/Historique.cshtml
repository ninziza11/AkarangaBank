@model IEnumerable<AkarangaBank.Web.Models.VirementInterAgence>

@{
    ViewData["Title"] = "Historique des virements inter-agences";

    DateTime? dateDu = ViewBag.Du;
    DateTime? dateAu = ViewBag.Au;

    var valeurDu = dateDu?.ToString("yyyy-MM-dd");
    var valeurAu = dateAu?.ToString("yyyy-MM-dd");
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between
                align-items-center gap-3 mb-4">

        <div>
            <h1 class="h3 mb-2">
                Historique des virements inter-agences
            </h1>

            <p class="text-muted mb-0">
                Consultez les virements entrants et sortants
                de votre agence.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", "VirementsInterAgences")"
               class="btn btn-outline-secondary">
                Virements en attente
            </a>

            @if (User.IsInRole("guichetier"))
            {
                <a href="@Url.Action("Initier", "VirementsInterAgences")"
                   class="btn btn-primary">
                    + Nouveau virement
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] is string messageSucces)
    {
        <div class="alert alert-success" role="status">
            @messageSucces
        </div>
    }

    @if (TempData["Error"] is string messageErreur)
    {
        <div class="alert alert-danger" role="alert">
            @messageErreur
        </div>
    }

    <!-- Filtres par date de création -->
    <div class="card mb-4">
        <div class="card-body">
            <h2 class="h5 mb-3">
                Filtrer par date de création
            </h2>

            <form action="@Url.Action(
                              "Historique",
                              "VirementsInterAgences")"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">
                        <label for="du" class="form-label">
                            Du
                        </label>

                        <input id="du"
                               name="du"
                               type="date"
                               class="form-control"
                               value="@valeurDu" />
                    </div>

                    <div class="col-md-4">
                        <label for="au" class="form-label">
                            Au
                        </label>

                        <input id="au"
                               name="au"
                               type="date"
                               class="form-control"
                               value="@valeurAu" />
                    </div>

                    <div class="col-md-4">
                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit"
                                    class="btn btn-primary">
                                Filtrer
                            </button>

                            <a href="@Url.Action(
                                         "Historique",
                                         "VirementsInterAgences")"
                               class="btn btn-outline-secondary">
                                Réinitialiser
                            </a>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    @Html.ValidationSummary(
        false,
        "",
        new { @class = "text-danger" })

    @if (Model is null)
    {
        <div class="alert alert-warning" role="alert">
            L’historique n’a pas été transmis à la page.
            Vérifiez l’action Historique du contrôleur.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">

                <caption>
                    Historique des virements inter-agences,
                    classés par date de création décroissante.
                </caption>

                <thead>
                    <tr>
                        <th scope="col">Date de création</th>
                        <th scope="col">Référence</th>
                        <th scope="col">Agence source</th>
                        <th scope="col">Agence destination</th>
                        <th scope="col" class="text-end">
                            Montant
                        </th>
                        <th scope="col">Statut</th>
                        <th scope="col">Motif du rejet</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        var contientVirements = false;
                    }

                    @foreach (var virement in Model)
                    {
                        contientVirements = true;

                        var libelleStatut = virement.Statut;
                        var classeStatut = "bg-secondary";

                        switch (virement.Statut)
                        {
                            case "EnAttente":
                                libelleStatut = "En attente";
                                classeStatut = "bg-warning text-dark";
                                break;

                            case "EnCompensation":
                                libelleStatut = "En compensation";
                                classeStatut = "bg-info text-dark";
                                break;

                            case "Valide":
                                libelleStatut = "Validé";
                                classeStatut = "bg-success";
                                break;

                            case "Rejete":
                                libelleStatut = "Rejeté";
                                classeStatut = "bg-danger";
                                break;
                        }

                        <tr>
                            <td>
                                @virement.DateCreation.ToString(
                                    "dd/MM/yyyy HH:mm")
                            </td>

                            <td>
                                @virement.Reference
                            </td>

                            <td>
                                @(virement.AgenceSource?.Code
                                    ?? "Agence non chargée")
                            </td>

                            <td>
                                @(virement.AgenceDestination?.Code
                                    ?? "Agence non chargée")
                            </td>

                            <td class="text-end">
                                @virement.Montant.ToString("N2")
                                @virement.Devise
                            </td>

                            <td>
                                <span class="badge @classeStatut">
                                    @libelleStatut
                                </span>
                            </td>

                            <td>
                                @if (string.IsNullOrWhiteSpace(
                                    virement.MotifRejet))
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @virement.MotifRejet
                                }
                            </td>
                        </tr>
                    }

                    @if (!contientVirements)
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                Aucun virement trouvé pour votre agence
                                avec les filtres sélectionnés.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

    <div class="mt-4">
        <a href="@Url.Action("Index", "Home")"
           class="btn btn-outline-secondary">
            Retour à l’accueil
        </a>
    </div>

</div>