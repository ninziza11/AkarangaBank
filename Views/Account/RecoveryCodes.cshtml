@model List<string>
@{
    ViewData["Title"] = "Codes de récupération";
}

<div class="card-custom mx-auto" style="max-width: 560px;">
    <h1 class="h4 fw-bold mb-2"><i class="bi bi-check-circle-fill text-success me-2" aria-hidden="true"></i>2FA activée</h1>
    <p>Sauvegardez ces codes de récupération dans un endroit sûr. <strong>Ils ne seront plus jamais affichés.</strong>
       Chaque code ne marche qu'une fois, si vous perdez votre téléphone.</p>

    <div class="row g-2 mb-4">
        @foreach (var code in Model)
        {
            <div class="col-6"><code class="d-block text-center p-2 rounded bg-dark fs-6">@code</code></div>
        }
    </div>

    <div class="d-flex gap-2">
        <button type="button" class="btn btn-outline-warning" onclick="window.print()">
            <i class="bi bi-printer me-1" aria-hidden="true"></i> Imprimer
        </button>
        <a class="btn btn-warning fw-bold ms-auto" asp-action="Manage">J'ai sauvegardé mes codes</a>
    </div>
</div>