@using AkarangaBank.Web.ViewModels
@model UserCreateViewModel

@{
    ViewData["Title"] = "Créer un utilisateur";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h4 class="mb-0"><i class="bi bi-person-plus-fill"></i> Administration - Nouvel Acteur Système</h4>
            </div>
            <div class="card-body">
                <form asp-action="CreateUser" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Identifiant -->
                    <div class="mb-3">
                        <label asp-for="Identifiant" class="form-label fw-bold small"></label>
                        <input asp-for="Identifiant" class="form-control font-monospace" placeholder="Ex: guichetier_gitega, mbonimpa_j" />
                        <span asp-validation-for="Identifiant" class="text-danger small"></span>
                    </div>

                    <!-- Nom Complet -->
                    <div class="mb-3">
                        <label asp-for="NomComplet" class="form-label fw-bold small"></label>
                        <input asp-for="NomComplet" class="form-control" placeholder="Ex: Jean-Marie Mbonimpa" />
                        <span asp-validation-for="NomComplet" class="text-danger small"></span>
                    </div>

                    <!-- Rôle (Contrainte CK_Utilisateurs_Role) -->
                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-bold small"></label>
                        <select asp-for="Role" class="form-select">
                            <option value="client">Client (Consultation & Virements)</option>
                            <option value="guichetier">Guichetier (Opérations de Caisse)</option>
                            <option value="gestionnaire">Gestionnaire (Validations & Prêts)</option>
                            <option value="auditeur">Auditeur (Piste d'Audit & Journal en Lecture Seule)</option>
                            <option value="admin">Administrateur (Gestion Complète du Système)</option>
                        </select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>

                    <!-- Mot de passe -->
                    <div class="mb-3">
                        <label asp-for="MotDePasse" class="form-label fw-bold small"></label>
                        <input asp-for="MotDePasse" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="MotDePasse" class="text-danger small"></span>
                    </div>

                    <!-- Confirmer Mot de passe -->
                    <div class="mb-4">
                        <label asp-for="ConfirmerMotDePasse" class="form-label fw-bold small"></label>
                        <input asp-for="ConfirmerMotDePasse" type="password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmerMotDePasse" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-check-circle"></i> Enregistrer l'acteur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
