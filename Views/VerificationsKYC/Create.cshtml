@model AkarangaBank.Web.ViewModels.VerificationKYCCreateViewModel

@{
    ViewData["Title"] = "Déposer un Document KYC";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Clients" asp-action="Index">Clients</a></li>
            <li class="breadcrumb-item"><a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId">Dossier Client</a></li>
            <li class="breadcrumb-item active" aria-current="page">Déposer une pièce KYC</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white py-3">
                    <h4 class="mb-0 card-title"><i class="bi bi-shield-check me-2"></i> Enregistrer une Pièce Justificative</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-secondary border-0 bg-light-subtle text-dark mb-4">
                        <small class="text-muted d-block text-uppercase fw-bold mb-1">Dossier Client associé :</small>
                        <!-- CORRECTION ICI : Remplacement de ClientNomComplet par ClientNom -->
                        <h5 class="mb-0 text-secondary"><i class="bi bi-person-badge-fill me-1"></i> @Model.ClientNom</h5>
                        <small class="text-muted">N° Identifiant : <strong>@Model.ClientNumero</strong></small>
                    </div>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ClientId" />
                        <!-- CORRECTION ICI : Remplacement de ClientNomComplet par ClientNom -->
                        <input type="hidden" asp-for="ClientNom" />
                        <input type="hidden" asp-for="ClientNumero" />

                        <!-- Type de Document -->
                        <div class="mb-4">
                            <label asp-for="TypeDocument" class="form-label fw-bold">Nature du justificatif</label>
                            <select asp-for="TypeDocument" class="form-select form-select-lg">
                                <option value="">-- Choisissez le type de pièce --</option>
                                <option value="CNI">Carte Nationale d'Identité (CNI)</option>
                                <option value="Passeport">Passeport International</option>
                                <option value="Permis">Permis de Conduire</option>
                                <option value="RegistreCommerce">Registre de Commerce (Personnes Morales)</option>
                            </select>
                            <span asp-validation-for="TypeDocument" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Numéro du Document -->
                        <div class="mb-4">
                            <label asp-for="NumeroDocument" class="form-label fw-bold">Numéro unique du document</label>
                            <input asp-for="NumeroDocument" class="form-control" placeholder="Ex: N° CNI ou N° Passeport" />
                            <span asp-validation-for="NumeroDocument" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Chemin / Fichier (Simulation pour le Chapitre 6) -->
                        <div class="mb-4">
                            <label asp-for="CheminDocument" class="form-label fw-bold">Fichier numérisé (Chemin ou nom de fichier)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-file-earmark-pdf"></i></span>
                                <input asp-for="CheminDocument" class="form-control" placeholder="Ex: cni_client5.pdf" />
                            </div>
                            <span asp-validation-for="CheminDocument" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text small text-muted">
                                La gestion des fichiers réels (Upload physique) sera approfondie au Chapitre 12.
                            </div>
                        </div>

                        <!-- Boutons d'action -->
                        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                            <a asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-secondary btn-lg px-4 shadow-sm">
                                <i class="bi bi-cloud-arrow-up-fill me-1"></i> Soumettre au contrôle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
