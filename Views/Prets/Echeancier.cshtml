@model IEnumerable<AkarangaBank.Web.Models.EcheancePret>
@{
    Layout = "_Layout";
    var pret = ViewBag.Pret as AkarangaBank.Web.Models.Pret;
    ViewData["Title"] = $"Échéancier Prêt N° {pret?.Reference}";
    
    // Initialisation du capital restant dû avant le démarrage de la boucle comptable
    decimal capitalRestantCalcul = pret?.MontantPrincipal ?? 0m;
}

<div class="container-fluid" role="region" aria-labelledby="title">
    <!-- 🏢 EN-TÊTE DE LA PAGE HARMONISÉ -->
    <div class="card card-custom p-4 mb-4 border-start border-primary border-5 bg-white shadow-sm">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 id="title" class="h3 fw-bold text-dark mb-1">
                    <i class="bi bi-calendar3 text-primary me-2"></i> Tableau d'Amortissement Obligatoire
                </h1>
                <p class="text-muted small mb-0">Plan de remboursement à mensualités constantes. Référence : <span class="font-monospace fw-bold">@pret?.Reference</span></p>
            </div>
            <a asp-action="Index" class="btn btn-sm btn-outline-dark fw-bold">
                <i class="bi bi-arrow-left"></i> Retour au portefeuille
            </a>
        </div>
    </div>

    <!-- 📊 SYNTHÈSE FINANCIÈRE DU FINANCEMENT -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card card-custom p-3 bg-white border-0 shadow-sm">
                <span class="text-muted small fw-bold text-uppercase">Capital Emprunté</span>
                <span class="h4 fw-bold font-monospace text-dark mt-1">@string.Format("{0:N2}", pret?.MontantPrincipal) BIF</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-3 bg-white border-0 shadow-sm">
                <span class="text-muted small fw-bold text-uppercase">Mensualité Globale</span>
                <span class="h4 fw-bold font-monospace text-success mt-1">@string.Format("{0:N2}", pret?.Mensualite) BIF</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-custom p-3 bg-white border-0 shadow-sm">
                <span class="text-muted small fw-bold text-uppercase">Conditions appliquées</span>
                <span class="h4 fw-bold font-monospace text-secondary mt-1">@pret?.TauxInteret% l'an sur @pret?.DureeMois mois</span>
            </div>
        </div>
    </div>

    <!-- 🗓️ TABLEAU DES MENSALITÉS RÉGLEMENTAIRES (BRB) -->
    <div class="card card-custom p-0 border-0 bg-white overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 small">
                <thead class="table-dark">
                    <tr>
                        <th class="text-center">Échéance</th>
                        <th>Date Limite</th>
                        <th class="text-end">Part Intérêt</th>
                        <th class="text-end">Part Capital Amorti</th>
                        <th class="text-end">Mensualité Totale</th>
                        <th class="text-end">Capital Restant Dû</th>
                        <th class="text-center">Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-exclamation-triangle text-warning me-2"></i> Ce prêt est en attente d'approbation. L'échéancier sera généré lors du déblocage des fonds.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            // Déduction du capital amorti au fil des mois pour calculer le restant dû en temps réel [1f2]
                            capitalRestantCalcul -= item.Capital;
                            <tr>
                                <td class="text-center font-monospace fw-bold">Mois @item.NumeroEcheance</td>
                                <td class="font-monospace">@item.DateEcheance.ToString("dd/MM/yyyy")</td>
                                <td class="text-end font-monospace text-danger">- @string.Format("{0:N2}", item.Interet) BIF</td>
                                <td class="text-end font-monospace text-primary">+ @string.Format("{0:N2}", item.Capital) BIF</td>
                                <td class="text-end font-monospace fw-bold text-dark">@string.Format("{0:N2}", item.MontantTotal) BIF</td>
                                <td class="text-end font-monospace text-secondary fw-bold">@string.Format("{0:N2}", Math.Max(0, capitalRestantCalcul)) BIF</td>
                                <td class="text-center">
                                    @if (item.Statut == "EnAttente") 
                                    { 
                                        <span class="badge bg-warning text-dark">Dû</span> 
                                    }
                                    else 
                                    { 
                                        <span class="badge bg-success">Encaissé</span> 
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
