@model IEnumerable<AkarangaBank.Web.Models.Pret>
@{
    ViewData["Title"] = "Portefeuille des Engagements";
}

<div class="container-fluid" role="region" aria-labelledby="main-title">
    <div class="card card-custom p-4 mb-4 border-start border-primary border-5 bg-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h1 id="main-title" class="h3 fw-bold text-dark mb-1"><i class="bi bi-cash-coin text-primary me-2"></i> Portefeuille des Prêts & Crédits</h1>
                <p class="text-muted small mb-0">Suivi comptable des engagements, encours d'agences et suivi des mensualités constantes.</p>
            </div>
            <a asp-action="Saisir" class="btn btn-primary btn-sm fw-bold"><i class="bi bi-plus-lg"></i> Saisir une Demande</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success small"><i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]</div>
    }

    <div class="card card-custom p-0 border-0 bg-white overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 small">
                <thead class="table-dark">
                    <tr>
                        <th>N° Prêt</th>
                        <th>Montant principal</th>
                        <th>Taux (%)</th>
                        <th>Durée (Mois)</th>
                        <th>Mensualité</th>
                        <th>Statut</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-monospace fw-bold">#@item.Id.ToString("D4")</td>
                            <td class="font-monospace fw-bold">@string.Format("{0:N2}", item.MontantPrincipal) BIF</td>
                            <td class="font-monospace">@item.TauxInteret %</td>
                            <td class="font-monospace">@item.DureeMois mois</td>
                            <td class="font-monospace text-success fw-bold">@string.Format("{0:N2}", item.Mensualite) BIF</td>
                            <td>
                                @if (item.Statut == "EnAttente") { <span class="badge bg-warning text-dark">En Analyse</span> }
                                else { <span class="badge bg-success">Approuvé & Débloqué</span> }
                            </td>
                            <td class="text-end">
                                @if (item.Statut == "EnAttente")
                                {
                                    <form asp-action="Valider" asp-route-id="@item.Id" method="post" class="m-0 d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-xs btn-success py-0 px-2 fw-bold" style="font-size:0.75rem;">Approuver</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
