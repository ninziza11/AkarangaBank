@model IEnumerable<AkarangaBank.Web.Models.ApplicationUser>
@{
    ViewData["Title"] = "Administration des utilisateurs";
    var utilisateurs = Model?.ToList() ?? new List<AkarangaBank.Web.Models.ApplicationUser>();
}

<style>
    .table-utilisateurs thead th {
        background-color: #0f172a;
        color: #ffffff;
        border-bottom: 3px solid #f59e0b;
        font-weight: 600;
        white-space: nowrap;
    }
    .table-utilisateurs {
        --bs-table-bg: transparent;
        --bs-table-color: #f8fafc;
        --bs-table-hover-bg: rgba(245, 158, 11, 0.08);
        --bs-table-hover-color: #f8fafc;
        --bs-table-border-color: #334155;
    }
</style>

<div class="container-fluid p-0" role="region" aria-labelledby="page-title">

    <div class="card-custom mb-4" style="border-left: 5px solid #f59e0b;">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 id="page-title" class="h4 fw-bold mb-1">
                    <i class="bi bi-people-fill text-warning me-2" aria-hidden="true"></i>Administration des utilisateurs
                </h1>
                <p class="small mb-0 text-secondary">Habilitations, agences d'affectation et sécurité 2FA.</p>
            </div>
            <a asp-action="Create" class="btn btn-warning fw-bold px-3 py-2">
                <i class="bi bi-person-plus-fill me-1" aria-hidden="true"></i> Nouvel utilisateur
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string msgSucces)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i> <span>@msgSucces</span>
        </div>
    }
    @if (TempData["Error"] is string msgErreur)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> <span>@msgErreur</span>
        </div>
    }

    <div class="card-custom p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover table-utilisateurs align-middle mb-0">
                <caption class="visually-hidden">Liste des utilisateurs de la banque</caption>
                <thead>
                    <tr>
                        <th scope="col" class="p-3">Nom complet</th>
                        <th scope="col">Identifiant</th>
                        <th scope="col">E-mail</th>
                        <th scope="col">Rôle</th>
                        <th scope="col">Agence</th>
                        <th scope="col" class="text-center">2FA</th>
                        <th scope="col" class="text-center">Statut</th>
                        <th scope="col" class="text-end p-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (utilisateurs.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <i class="bi bi-people fs-2 d-block mb-2" aria-hidden="true"></i>
                                Aucun utilisateur enregistré.
                            </td>
                        </tr>
                    }

                    @foreach (var u in utilisateurs)
                    {
                        <tr>
                            <td class="p-3 fw-bold">@u.NomComplet</td>
                            <td class="font-monospace">@u.UserName</td>
                            <td class="font-monospace">@u.Email</td>
                            <td><span class="badge bg-secondary">@u.Role</span></td>
                            <td class="font-monospace fw-bold">@(u.Agence != null ? u.Agence.Code : "—")</td>
                            <td class="text-center">
                                @if (u.DeuxFA_Active)
                                {
                                    <span class="badge bg-success">Activée</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.EstActif)
                                {
                                    <span class="badge bg-success">Actif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Suspendu</span>
                                }
                            </td>
                            <td class="text-end p-3">
                                <form asp-action="ToggleActif" asp-route-id="@u.Id" method="post" class="m-0 d-inline"
                                      onsubmit="return confirm('Modifier l\'accès de cet utilisateur ?');">
                                    <button type="submit"
                                            class="btn btn-sm fw-bold px-3 @(u.EstActif ? "btn-outline-danger" : "btn-warning")">
                                        <i class="bi @(u.EstActif ? "bi-lock-fill" : "bi-unlock-fill")" aria-hidden="true"></i>
                                        @(u.EstActif ? "Suspendre" : "Activer")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>