@model AkarangaBank.Web.ViewModels.ChequierSuiviViewModel
@{
    ViewData["Title"] = "Gestion des Chéquiers";
}

<div class="container-fluid" role="region" aria-labelledby="page-title">
    <!-- 🏢 EN-TÊTE DU MODULE MONÉTIQUE -->
    <div class="card card-custom p-4 mb-4 border-start border-primary border-5 bg-white">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 id="page-title" class="h3 fw-bold text-dark mb-1">
                    <i class="bi bi-journal-bookmark-fill text-primary me-2"></i> Suivi & Commandes de Chéquiers
                </h1>
                <p class="text-muted small mb-0">Registre des carnets de chèques, cycles de fabrication et mises en opposition d'urgence.</p>
            </div>
            <div>
                <form asp-action="Index" method="get" class="d-flex gap-2">
                    <select name="statut" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- Tous les statuts --</option>
                        <option value="Commande">Commandés</option>
                        <option value="EnFabrication">En Fabrication</option>
                        <option value="Pret">Prêts en Agence</option>
                        <option value="Remis">Remis aux Clients</option>
                        <option value="Opposition">En Opposition</option>
                    </select>
                </form>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show small" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-submit="alert" aria-label="Fermer"></button>
        </div>
    }

    <!-- 🗄️ LISTE DES DOSSIERS DE CHÉQUIERS -->
    <div class="card card-custom p-0 border-0 bg-white overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0 small" aria-label="Registre des chéquiers">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Réf.</th>
                        <th scope="col">N° Compte</th>
                        <th scope="col">Plage de Numéros</th>
                        <th scope="col">Feuillets</th>
                        <th scope="col">Statut Réglementaire</th>
                        <th scope="col" class="text-end">Actions Habilitées</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Chequiers != null && Model.Chequiers.Any())
                    {
                        foreach (var item in Model.Chequiers)
                        {
                            <tr>
                                <td class="font-monospace fw-bold text-secondary">#@item.Id.ToString("D4")</td>
                                <td class="font-monospace fw-bold text-dark">@(item.Compte?.NumeroCompte ?? "BIF-CORE-TECH")</td>
                                <td class="font-monospace">Chèques @item.NumeroDebut à @item.NumeroFin</td>
                                <td><span class="badge bg-light text-dark border">@item.NombreFeuillets</span></td>
                                <td>
                                    @if (item.Statut == "Commande") { <span class="badge bg-info">Demandé</span> }
                                    else if (item.Statut == "EnFabrication") { <span class="badge bg-primary">En Fabrication BRB</span> }
                                    else if (item.Statut == "Pret") { <span class="badge bg-warning text-dark">Prêt en Coffre</span> }
                                    else if (item.Statut == "Remis") { <span class="badge bg-success">Remis au Client</span> }
                                    else if (item.Statut == "Opposition") { <span class="badge bg-danger animate-pulse">🔒 OPPOSITION</span> }
                                    else { <span class="badge bg-secondary">@item.Statut</span> }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (item.Statut != "Remis" && item.Statut != "Opposition" && item.Statut != "Annule")
                                        {
                                            <form asp-action="AvancerStatut" asp-route-id="@item.Id" method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-dark py-0 px-2 fw-bold" style="font-size:0.75rem;">
                                                    <i class="bi bi-arrow-right-short"></i> Évoluer
                                                </button>
                                            </form>
                                        }
                                        @if (item.Statut != "Opposition" && item.Statut != "Annule")
                                        {
                                            <a asp-action="Opposition" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger py-0 px-2 fw-bold" style="font-size:0.75rem;">
                                                <i class="bi bi-shield-lock"></i> Bloquer
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">Aucun carnet de chèques répertorié pour ce filtre.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
